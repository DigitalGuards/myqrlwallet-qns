==== Source: QNSPublicResolver.hyp ====
import {QNSHarness} from "_harness/QNSHarness.hyp";
import {IQNSRegistry} from "_canonical/vendored/registry/IQNSRegistry.hyp";
import {QRLPublicResolver} from "_canonical/resolvers/QRLPublicResolver.hyp";
import {ResolverBase} from "_canonical/vendored/resolvers/ResolverBase.hyp";

// QRLPublicResolver with QRLResolverAuthorization: owner-only record writes,
// registry operators rejected, record versions, and the setName-only trusted
// registrar capability. Two extra resolver instances use other trust
// settings: instance 1 trusts actor 4, instance 2 trusts nobody.
contract QNSPublicResolverTest is QNSHarness {
    QRLPublicResolver internal trustingActor4;
    QRLPublicResolver internal trustingNobody;

    constructor() {
        trustingActor4 = new QRLPublicResolver(IQNSRegistry(address(registry)), address(actors[4]));
        trustingNobody = new QRLPublicResolver(IQNSRegistry(address(registry)), address(0));
    }

    function extra(uint8 which) internal view returns (QRLPublicResolver) {
        return which == 1 ? trustingActor4 : trustingNobody;
    }
    function extraIdentity(uint8 which) external view returns (address, address) {
        return (address(extra(which)), extra(which).trustedReverseRegistrar());
    }
    function extraSetName(uint8 a, uint8 which, bytes32 node, string memory name_) external {
        _act(a, address(extra(which)), abi.encodeCall(QRLPublicResolver.setName, (node, name_)));
    }
    function extraSetAddr(uint8 a, uint8 which, bytes32 node, address value) external {
        _act(a, address(extra(which)), abi.encodeCall(QRLPublicResolver.setAddr, (node, value)));
    }
    function extraSetText(uint8 a, uint8 which, bytes32 node, string memory key, string memory value) external {
        _act(a, address(extra(which)), abi.encodeCall(QRLPublicResolver.setText, (node, key, value)));
    }
    function extraSetContenthash(uint8 a, uint8 which, bytes32 node, bytes memory hash) external {
        _act(a, address(extra(which)), abi.encodeCall(QRLPublicResolver.setContenthash, (node, hash)));
    }
    function extraClearRecords(uint8 a, uint8 which, bytes32 node) external {
        _act(a, address(extra(which)), abi.encodeCall(ResolverBase.clearRecords, (node)));
    }
    function extraName(uint8 which, bytes32 node) external view returns (string memory) {
        return extra(which).name(node);
    }
}
