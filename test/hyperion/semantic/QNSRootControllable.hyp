==== Source: QNSRootControllable.hyp ====
import {QNSHarness} from "_harness/QNSHarness.hyp";

// Root with Controllable and Ownable: controller-only TLD assignment, owner-only
// locks, resolver and controller management, ownership transfer and renounce.
// Actor 0 (the deployer) owns Root and is its first controller.
contract QNSRootControllableTest is QNSHarness {}
