import {QNSHarness} from "_harness/QNSHarness.hyp";

// QNSRegistry: every external function, success and revert paths, and the
// owner / operator / stranger matrix. Actor 0 is the deployer (Root owner and
// controller, owner of `reverse`); actors 1 to 4 are distinct contracts.
contract QNSRegistryTest is QNSHarness {}
