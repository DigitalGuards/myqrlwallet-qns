==== Source: QNSReverseRegistrar.hyp ====
import {QNSHarness} from "_harness/QNSHarness.hyp";
import {IQNSRegistry} from "_canonical/vendored/registry/IQNSRegistry.hyp";
import {ReverseRegistrar} from "_canonical/vendored/reverseRegistrar/ReverseRegistrar.hyp";

// ReverseRegistrar with QRLAddressReverse: claims, the authorization matrix
// (the address itself, registry operator, controller, owner of a contract,
// stranger), names through the trusted resolver, the default resolver,
// ownership, and the constructor's migration claim. Actors are contracts
// without an owner() function; the twin and zero addresses have no code.
contract QNSReverseRegistrarTest is QNSHarness {
    function deployReverseRegistrar() external returns (address) {
        return address(new ReverseRegistrar(IQNSRegistry(address(registry))));
    }
}
