==== Source: QNSReRegistration.hyp ====
import {QNSHarness} from "_harness/QNSHarness.hyp";

// Release and re-registration under the FIFS registrar: what a fresh claim
// resets in the registry, what stays on the public resolver until the new
// owner clears it, and which subnames the new parent owner can take back.
contract QNSReRegistrationTest is QNSHarness {}
