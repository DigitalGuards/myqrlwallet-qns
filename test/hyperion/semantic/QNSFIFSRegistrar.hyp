==== Source: QNSFIFSRegistrar.hyp ====
import {QNSHarness} from "_harness/QNSHarness.hyp";

// FIFSQRLRegistrar: first come first served under .qrl, re-registration by the
// exact current owner only, availability after release, and behaviour when the
// registrar loses or keeps the TLD.
contract QNSFIFSRegistrarTest is QNSHarness {}
