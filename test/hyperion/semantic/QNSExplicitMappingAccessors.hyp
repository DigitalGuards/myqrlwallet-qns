import {Controllable} from "_canonical/vendored/root/Controllable.hyp";
import {Root} from "_canonical/vendored/root/Root.hyp";
import {ResolverBase} from "_canonical/vendored/resolvers/ResolverBase.hyp";
import {IQNSRegistry} from "_canonical/vendored/registry/IQNSRegistry.hyp";

contract ResolverVersionHarness is ResolverBase {
    function isAuthorised(bytes32) internal pure override returns (bool) {
        return true;
    }
}

contract QNSExplicitMappingAccessors {
    Controllable private _controllable;
    Root private _root;
    ResolverVersionHarness private _resolver;

    constructor() {
        _controllable = new Controllable();
        _root = new Root(IQNSRegistry(address(0)));
        _resolver = new ResolverVersionHarness();
    }

    function setController(address controller, bool enabled) external {
        _controllable.setController(controller, enabled);
    }

    function controller(address account) external view returns (bool) {
        return _controllable.controllers(account);
    }

    function lock(bytes32 label) external {
        _root.lock(label);
    }

    function isLocked(bytes32 label) external view returns (bool) {
        return _root.locked(label);
    }

    function clear(bytes32 node) external {
        _resolver.clearRecords(node);
    }

    function version(bytes32 node) external view returns (uint64) {
        return _resolver.recordVersions(node);
    }
}
