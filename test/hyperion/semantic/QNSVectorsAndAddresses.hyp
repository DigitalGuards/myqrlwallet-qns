{{QNS_EXTERNAL_SOURCES}}
==== Source: QNSVectorsAndAddresses.hyp ====
import {QNSHarness} from "_harness/QNSHarness.hyp";
import {QRLAddressReverse} from "_canonical/reverse/QRLAddressReverse.hyp";

// Known answers shared with the SDK (sdk/src/fixtures/qns-vectors.json, filled
// in by the runner) and 64-byte address edge cases: the zero and maximum
// addresses, and addresses or bytes32 keys that differ only in their high or
// low bytes, across the registry, Root and the reverse encoding.
contract QNSVectorsAndAddressesTest is QNSHarness {
    function reverseLabel(address addr) external pure returns (bytes32) {
        return QRLAddressReverse.labelHash(addr);
    }
    function reverseEncoding(address addr) external pure returns (string memory) {
        return string(QRLAddressReverse.encode(addr));
    }
    function namehash2(string memory child, string memory parent) external pure returns (bytes32) {
        bytes32 parentNode = keccak256(abi.encodePacked(bytes32(0), keccak256(bytes(parent))));
        return keccak256(abi.encodePacked(parentNode, keccak256(bytes(child))));
    }
}
