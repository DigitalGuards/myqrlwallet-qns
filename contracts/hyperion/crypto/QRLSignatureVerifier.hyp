pragma hyperion >=0.0;

/// @title QRLSignatureVerifier
/// @notice QNS adapter for the QRL 2.0 SHAKE256 and ML-DSA-87 precompiles.
/// @dev QNS signs a 64-byte SHAKE256 digest with the context QNS-SIGN-v1.
contract QRLSignatureVerifier {
    function qnsContext() internal pure returns (bytes memory) {
        return bytes("QNS-SIGN-v1");
    }

    function digest(bytes memory message) public pure returns (bytes memory) {
        return abi.encodePacked(shake256(message));
    }

    function verifyDigest(
        bytes memory messageDigest,
        bytes memory signature,
        bytes memory publicKey,
        bytes memory context
    ) public pure returns (bool) {
        if (messageDigest.length != 64) {
            return false;
        }
        bytes64 digestValue = bytes64(messageDigest);
        return mldsa87verify(digestValue, signature, publicKey, context);
    }

    function verify(
        bytes memory message,
        bytes memory signature,
        bytes memory publicKey
    ) public pure returns (bool) {
        bytes64 digestValue = shake256(message);
        bytes memory context = qnsContext();
        return mldsa87verify(digestValue, signature, publicKey, context);
    }
}
