pragma hyperion >=0.0;

import {IQNSRegistry} from "../vendored/registry/IQNSRegistry.hyp";
import {ResolverBase} from "../vendored/resolvers/ResolverBase.hyp";
import {IAddrResolver} from "../vendored/resolvers/profiles/IAddrResolver.hyp";
import {ITextResolver} from "../vendored/resolvers/profiles/ITextResolver.hyp";
import {IContentHashResolver} from "../vendored/resolvers/profiles/IContentHashResolver.hyp";
import {INameResolver} from "../vendored/resolvers/profiles/INameResolver.hyp";
import {QRLResolverAuthorization} from "./QRLResolverAuthorization.hyp";

/// @title QRLPublicResolver
/// @notice QRL 2.0 resolver using Hyperion's native 64-byte address type.
///         Supports `IAddrResolver`, `ITextResolver`, `IContentHashResolver`,
///         and reverse names.
///
/// Authorisation: only the current owner of a node in the QNS registry can
/// write records. The trusted reverse registrar has the narrower ability to
/// call `setName`, which is required after it assigns a reverse node to its
/// final owner. The underlying `ResolverBase` provides ERC165 + versioned
/// records (clearRecords bumps a per-node version counter).
///
/// Deliberately omitted for alpha:
///   - `IAddressResolver` (EIP-2304 multichain addr): future work.
///   - `IPubkeyResolver`: future work for ML-DSA pubkey storage.
///   - `IInterfaceResolver` / `IABIResolver`: optional, revisit Phase 3.
///   - NameWrapper / DNS / ENSIP-10: out of scope.
contract QRLPublicResolver is
    ResolverBase,
    IAddrResolver,
    ITextResolver,
    IContentHashResolver,
    INameResolver
{
    IQNSRegistry public immutable qns;
    /// Trusted reverse registrar, allowed to call setName() even when it is
    /// not the registry owner. This capability does not apply to other record
    /// setters or clearRecords. Settable once at deploy time.
    /// Set to address(0) to disable the trust relationship entirely.
    address public immutable trustedReverseRegistrar;

    mapping(uint64 => mapping(bytes32 => address)) private _addr;
    mapping(uint64 => mapping(bytes32 => mapping(string => string))) private _texts;
    mapping(uint64 => mapping(bytes32 => bytes)) private _contenthashes;
    mapping(uint64 => mapping(bytes32 => string)) private _names;

    error NotAuthorised(bytes32 node, address caller);

    constructor(IQNSRegistry _qns, address _trustedReverseRegistrar) {
        qns = _qns;
        trustedReverseRegistrar = _trustedReverseRegistrar;
    }

    /// @notice Compatibility getter retained for ENS-derived integrations.
    function ens() external view returns (IQNSRegistry) {
        return qns;
    }

    /// @inheritdoc ResolverBase
    function isAuthorised(bytes32 node) internal view override returns (bool) {
        return QRLResolverAuthorization.canWrite(qns.owner(node), msg.sender);
    }

    modifier authorisedName(bytes32 node) {
        if (!QRLResolverAuthorization.canSetName(
            qns.owner(node),
            msg.sender,
            trustedReverseRegistrar
        )) {
            revert NotAuthorised(node, msg.sender);
        }
        _;
    }

    // -----------------------------------------------------------------
    // IAddrResolver: native 64-byte QRL 2.0 address
    // -----------------------------------------------------------------

    function addr(bytes32 node) external view override returns (address payable) {
        return payable(_addr[recordVersions[node]][node]);
    }

    function setAddr(bytes32 node, address a) external authorised(node) {
        _addr[recordVersions[node]][node] = a;
        emit AddrChanged(node, a);
    }

    // -----------------------------------------------------------------
    // ITextResolver
    // -----------------------------------------------------------------

    function text(
        bytes32 node,
        string calldata key
    ) external view override returns (string memory) {
        return _texts[recordVersions[node]][node][key];
    }

    function setText(
        bytes32 node,
        string calldata key,
        string calldata value
    ) external authorised(node) {
        _texts[recordVersions[node]][node][key] = value;
        emit TextChanged(node, key, key, value);
    }

    // -----------------------------------------------------------------
    // IContentHashResolver
    // -----------------------------------------------------------------

    function contenthash(bytes32 node) external view override returns (bytes memory) {
        return _contenthashes[recordVersions[node]][node];
    }

    function setContenthash(bytes32 node, bytes calldata hash) external authorised(node) {
        _contenthashes[recordVersions[node]][node] = hash;
        emit ContenthashChanged(node, hash);
    }

    // -----------------------------------------------------------------
    // INameResolver (EIP-181 reverse record used by ReverseRegistrar)
    // -----------------------------------------------------------------

    function name(bytes32 node) external view override returns (string memory) {
        return _names[recordVersions[node]][node];
    }

    /// Called by `ReverseRegistrar.setNameForAddr` after it has claimed the
    /// reverse node and assigned it to the requested owner. The registrar is
    /// therefore admitted by the setName-only trust relationship.
    function setName(
        bytes32 node,
        string calldata newName
    ) external authorisedName(node) {
        _names[recordVersions[node]][node] = newName;
        emit NameChanged(node, newName);
    }

    // -----------------------------------------------------------------
    // ERC165
    // -----------------------------------------------------------------

    function supportsInterface(
        bytes4 interfaceID
    ) public view override(ResolverBase) returns (bool) {
        return
            interfaceID == type(IAddrResolver).interfaceId ||
            interfaceID == type(ITextResolver).interfaceId ||
            interfaceID == type(IContentHashResolver).interfaceId ||
            interfaceID == type(INameResolver).interfaceId ||
            super.supportsInterface(interfaceID);
    }
}
