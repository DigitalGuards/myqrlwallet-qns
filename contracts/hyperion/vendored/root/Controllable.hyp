// SPDX-License-Identifier: MIT
pragma hyperion >=0.0;

import "../openzeppelin/access/Ownable.hyp";

// QNS DIFF vs ensdomains/ens-contracts@v1.6.2: added no-arg constructor
// delegating to OZ v5 Ownable(msg.sender). Upstream was written against
// OZ v4 which had a no-arg Ownable. See vendored/DIFFS.md.
contract Controllable is Ownable {
    mapping(address => bool) private _controllers;

    event ControllerChanged(address indexed controller, bool enabled);

    modifier onlyController() {
        require(
            _controllers[msg.sender],
            "Controllable: Caller is not a controller"
        );
        _;
    }

    constructor() Ownable(msg.sender) {}

    /// @notice Returns whether an account is an enabled controller.
    /// @dev Explicit access preserves the full native 64-byte address key.
    function controllers(address controller) public view returns (bool) {
        return _controllers[controller];
    }

    function setController(address controller, bool enabled) public onlyOwner {
        _controllers[controller] = enabled;
        emit ControllerChanged(controller, enabled);
    }
}
