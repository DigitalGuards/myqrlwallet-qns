{
  "name": "myqrlwallet-qns",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "QRL Name Service, post-quantum port of ENS to QRL Zond",
  "scripts": {
    "compile": "node scripts/compile-hyperion.js",
    "test": "npm run compile && npm run test:scripts && npm run sdk:typecheck && npm run sdk:test",
    "test:scripts": "node --test test/scripts/*.test.js",
    "test:behavior": "npm run sdk:build && node --test test/behavior/*.test.js",
    "compile:hyperion": "node scripts/compile-hyperion.js",
    "build:local-network": "./scripts/build-local-node-image.sh && ./scripts/build-local-qrysm-images.sh",
    "kurtosis:start": "./scripts/kurtosis-start.sh",
    "kurtosis:stop": "./scripts/kurtosis-stop.sh",
    "deploy:testnet": "node scripts/deploy-testnet.js",
    "register": "node scripts/register-and-resolve.js",
    "verify:pq": "node scripts/verify-pq-precompiles.js",
    "verify:formal": "./scripts/verify-formal.sh",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:typecheck": "npm --prefix sdk run typecheck",
    "sdk:test": "npm --prefix sdk test"
  },
  "keywords": [
    "qrl",
    "qns",
    "ens",
    "post-quantum",
    "naming",
    "ml-dsa-87"
  ],
  "author": "DigitalGuards",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@theqrl/wallet.js": "^6.2.4",
    "@theqrl/web3": "1.0.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@theqrl/mldsa87": "^2.1.4"
  }
}
