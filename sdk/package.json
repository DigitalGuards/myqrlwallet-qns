{
  "name": "@qns/sdk",
  "version": "0.2.0-alpha.0",
  "description": "QRL Name Service client SDK for forward/reverse resolution on QRL Zond",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "npm run format:check && npm run lint",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "qrl",
    "qns",
    "ens",
    "naming",
    "post-quantum"
  ],
  "author": "DigitalGuards",
  "license": "GPL-3.0",
  "dependencies": {
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qrlwallet/connect": "5.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@qrlwallet/connect": ">=5.0.1 <6.0.0",
    "@theqrl/mldsa87": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@qrlwallet/connect": {
      "optional": true
    },
    "@theqrl/mldsa87": {
      "optional": true
    }
  }
}
